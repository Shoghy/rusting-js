{
  "name": "rusting-js",
  "type": "module",
  "author": {
    "name": "Shoghy Martinez"
  },
  "keywords": [
    "typescript",
    "rust"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Shoghy/rusting-js"
  },
  "files": [
    "**"
  ],
  "version": "0.2.2",
  "license": "MIT",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "bun run build.ts && bun run move_files.ts && tsc",
    "test": "bun test",
    "lint": "bun run biome-check.ts",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@swc/core": "^1.15.41",
    "@types/bun": "latest",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "jsdoc-example-runner": "^1.0.5",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./enums": {
      "types": "./enums/index.d.ts",
      "default": "./enums/index.js"
    },
    "./iterators": {
      "types": "./iterators/index.d.ts",
      "default": "./iterators/index.js"
    },
    "./slices": {
      "types": "./slices/index.d.ts",
      "default": "./slices/index.js"
    },
    "./strings": {
      "types": "./strings/index.d.ts",
      "default": "./strings/index.js"
    },
    "./traits": {
      "types": "./traits/index.d.ts",
      "default": "./traits/index.js"
    }
  }
}
